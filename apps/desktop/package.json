{
  "name": "@stepsvault/desktop",
  "productName": "StepsVault Sync",
  "version": "0.1.0",
  "private": true,
  "description": "StepsVault Sync for Windows: your vault's songs in your own StepMania, lined up with your own music.",
  "license": "Apache-2.0",
  "main": "dist/main/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "installer": "node scripts/build.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "~6.8.10"
  },
  "devDependencies": {
    "@stepsvault/sync-core": "workspace:*",
    "@stepsvault/sync-ui": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "~45.0.0",
    "electron-builder": "~26.18.0",
    "esbuild": "^0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "StepsVault",
  "homepage": "https://dancedance.studio"
}
